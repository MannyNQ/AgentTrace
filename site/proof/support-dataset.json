{
  "dataset": "support",
  "version": 2,
  "note": "The demo agent's eval dataset for the landing-page proof. Items 1-4 are the original v1 items; 5-15 were added on 2026-10-27 so the gate has the power to judge a drop. Refund and return questions expect lookup_order first; status questions are controls the prompt edit shouldn't touch.",
  "items": [
    {"input": {"question": "Where is order 1042?", "client": null}, "expected_output": "UPS", "expected_trajectory": [{"tool": "lookup_order", "args": {"order_id": "1042"}}]},
    {"input": {"question": "I'd like to return order 1043, I changed my mind.", "client": null}, "expected_trajectory": [{"tool": "lookup_order", "args": {"order_id": "1043"}}, {"tool": "issue_refund", "args": {"order_id": "1043"}}]},
    {"input": {"question": "Can I get a refund on order 1044?", "client": null}, "expected_output": "30", "expected_trajectory": [{"tool": "lookup_order", "args": {"order_id": "1044"}}]},
    {"input": {"question": "Where is order 1045?", "client": null}, "expected_trajectory": [{"tool": "escalate"}], "metadata": {"note": "fails on purpose: a status question shouldn't be escalated"}},
    {"input": {"question": "Is order 1043 still eligible for a refund?", "client": null}, "expected_trajectory": [{"tool": "lookup_order", "args": {"order_id": "1043"}}], "metadata": {"kind": "refund"}},
    {"input": {"question": "Can I still send back order 1044 and get my money back?", "client": null}, "expected_trajectory": [{"tool": "lookup_order", "args": {"order_id": "1044"}}], "metadata": {"kind": "refund"}},
    {"input": {"question": "Order 1042 hasn't arrived. Can I get a refund instead?", "client": null}, "expected_trajectory": [{"tool": "lookup_order", "args": {"order_id": "1042"}}], "metadata": {"kind": "refund"}},
    {"input": {"question": "Can I get a refund on order 1045?", "client": null}, "expected_trajectory": [{"tool": "lookup_order", "args": {"order_id": "1045"}}], "metadata": {"kind": "refund"}},
    {"input": {"question": "Am I too late to return order 1044?", "client": null}, "expected_trajectory": [{"tool": "lookup_order", "args": {"order_id": "1044"}}], "metadata": {"kind": "refund"}},
    {"input": {"question": "Please refund order 1042.", "client": null}, "expected_trajectory": [{"tool": "lookup_order", "args": {"order_id": "1042"}}], "metadata": {"kind": "refund"}},
    {"input": {"question": "How long do I have to return order 1043?", "client": null}, "expected_trajectory": [{"tool": "lookup_order", "args": {"order_id": "1043"}}], "metadata": {"kind": "refund"}},
    {"input": {"question": "When will order 1045 arrive?", "client": null}, "expected_trajectory": [{"tool": "lookup_order", "args": {"order_id": "1045"}}], "metadata": {"kind": "status"}},
    {"input": {"question": "Has order 1043 been delivered yet?", "client": null}, "expected_trajectory": [{"tool": "lookup_order", "args": {"order_id": "1043"}}], "metadata": {"kind": "status"}},
    {"input": {"question": "Which carrier is shipping order 1042?", "client": null}, "expected_output": "UPS", "expected_trajectory": [{"tool": "lookup_order", "args": {"order_id": "1042"}}], "metadata": {"kind": "status"}},
    {"input": {"question": "What's in order 1044?", "client": null}, "expected_trajectory": [{"tool": "lookup_order", "args": {"order_id": "1044"}}], "metadata": {"kind": "status"}}
  ]
}
