# Copy to .env and fill in. .env is gitignored.
ANTHROPIC_API_KEY=

# The ingest service registers this key for the default project on startup; the SDK sends it.
# This value is public: ingest only accepts it while AGENTTRACE_PUBLIC_URL is localhost.
AGENTTRACE_API_KEY=at-local-dev-key
# Where people open the web app, e.g. https://agenttrace.example.com. Defaults to localhost.
AGENTTRACE_PUBLIC_URL=
AGENTTRACE_ENDPOINT=http://localhost:8000
# Ingest's port listens on 127.0.0.1. Set 0.0.0.0 for agents on other machines, with a key of your own.
AGENTTRACE_INGEST_BIND=
# Claims the install in the web app. Leave empty to use the token ingest prints in its logs.
AGENTTRACE_SETUP_TOKEN=

POSTGRES_USER=agenttrace
POSTGRES_PASSWORD=agenttrace
POSTGRES_DB=agenttrace
CLICKHOUSE_USER=agenttrace
CLICKHOUSE_PASSWORD=agenttrace
# Must match infra/seaweedfs/s3.json
S3_ACCESS_KEY=agenttrace
S3_SECRET_KEY=agenttrace-secret
S3_BUCKET=payloads
