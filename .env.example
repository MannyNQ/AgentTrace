# Copy to .env and fill in. .env is gitignored.
ANTHROPIC_API_KEY=

# The ingest service registers this key for the default project on startup; the SDK sends it.
# This value is public: ingest only accepts it while TRAYCE_PUBLIC_URL is localhost.
TRAYCE_API_KEY=tr-local-dev-key
# Where people open the web app, e.g. https://trayce.example.com. Defaults to localhost.
TRAYCE_PUBLIC_URL=
TRAYCE_ENDPOINT=http://localhost:8000
# Ingest's port listens on 127.0.0.1. Set 0.0.0.0 for agents on other machines, with a key of your own.
TRAYCE_INGEST_BIND=
# How many reverse proxies sit in front of the web app (ADR-0041); it reads the browser's address
# from X-Forwarded-For that many entries from the right. Defaults to 1.
TRAYCE_PROXY_HOPS=
# Claims the install in the web app. Leave empty to use the token ingest prints in its logs.
TRAYCE_SETUP_TOKEN=

POSTGRES_USER=trayce
POSTGRES_PASSWORD=trayce
POSTGRES_DB=trayce
CLICKHOUSE_USER=trayce
CLICKHOUSE_PASSWORD=trayce
# SeaweedFS takes its S3 identity from these two (sdk/python/src/trayce/stack/seaweedfs-start.sh); change both here.
S3_ACCESS_KEY=trayce
S3_SECRET_KEY=trayce-secret
S3_BUCKET=payloads
